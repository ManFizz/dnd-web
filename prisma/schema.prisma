// Database schema. Auth tables follow the Better Auth core schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id
  name               String
  email              String              @unique
  emailVerified      Boolean             @default(false)
  image              String?
  /// "admin" can manage the shared spell library.
  role               String              @default("user")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  characters         Character[]
  spells             Spell[]
  events             CharacterEvent[]
  campaignsOwned     Campaign[]          @relation("CampaignOwner")
  memberships        CampaignMember[]
  invitesCreated     CampaignInvite[]
  campaignCharacters CampaignCharacter[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Better Auth rate limits, kept in the database so they hold across serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Character {
  id        String             @id @default(cuid())
  ownerId   String
  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  /// Short line for lists: "Проклятокровый, Волшебник 13".
  summary   String             @default("")
  avatarUrl String             @default("")
  /// Full character document (see src/lib/rules/schema.ts).
  data      Json
  /// Incremented on every save, used for optimistic concurrency.
  version   Int                @default(1)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  events    CharacterEvent[]
  campaign  CampaignCharacter?
  grants    Grant[]

  @@index([ownerId, updatedAt])
}

/// Journal of changes with the reason given by the player.
model CharacterEvent {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind        String
  summary     String
  reason      String    @default("")
  data        Json?
  createdAt   DateTime  @default(now())

  @@index([characterId, createdAt])
}

/// Spell library. ownerId = null: shared library (imported from dnd.su),
/// otherwise a homebrew spell that belongs to one user.
model Spell {
  id            String   @id @default(cuid())
  source        String
  externalId    String?
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  nameRu        String
  nameEn        String   @default("")
  level         Int
  school        String   @default("")
  ritual        Boolean  @default(false)
  concentration Boolean  @default(false)
  castingTime   String   @default("")
  range         String   @default("")
  components    String   @default("")
  duration      String   @default("")
  classes       String[]
  subclasses    String[]
  description   Json
  sourceBook    String   @default("")
  url           String   @default("")
  searchText    String   @default("")
  /// Extra mechanics: attack type, save, damage formula.
  mechanics     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([source, externalId])
  @@index([ownerId])
  @@index([level])
}

/// A campaign (room): the GM and the players with their characters.
model Campaign {
  id          String              @id @default(cuid())
  name        String
  description String              @default("")
  ownerId     String
  owner       User                @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Table rules (see src/lib/campaigns.ts).
  settings    Json
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     CampaignMember[]
  invites     CampaignInvite[]
  characters  CampaignCharacter[]
  /// Party stash: { items: Item[], coins: Record<coin, number> }.
  stash       Json                @default("{}")
  templates   CampaignTemplate[]
  grants      Grant[]
  creatures   Creature[]
  lootTables  LootTable[]
  lootDrafts  LootDraft[]
  mutations   MutationDraft[]

  @@index([ownerId])
}

/// GM library entry: an item, feature (mutation, curse, boon...) or counter
/// that can be granted to characters.
model CampaignTemplate {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// item | feature | counter
  kind       String
  name       String
  folder     String   @default("")
  tags       String[] @default([])
  /// The object itself, validated by the character schemas.
  body       Json
  /// Curse or boon stages: [{ name, effects }].
  stages     Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  grants     Grant[]

  @@index([campaignId])
}

/// One delivery of a template (or an ad-hoc object) to one character.
model Grant {
  id          String            @id @default(cuid())
  campaignId  String
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterId String
  character   Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  templateId  String?
  template    CampaignTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// item | feature | counter
  kind        String
  name        String
  /// Snapshot of the granted object as it was sent.
  payload     Json
  stages      Json              @default("[]")
  /// offered | active | removed | declined | detached
  status      String            @default("active")
  lock        String            @default("none")
  visibility  String            @default("visible")
  expires     String            @default("never")
  left        Int               @default(0)
  removal     String            @default("")
  reason      String            @default("")
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([campaignId, status])
  @@index([characterId, status])
  @@index([templateId])
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// gm (the owner), cogm, player, spectator.
  role       String   @default("player")
  /// active, or pending while the GM has not approved the join request.
  status     String   @default("active")
  joinedAt   DateTime @default(now())

  @@unique([campaignId, userId])
  @@index([userId])
}

model CampaignInvite {
  id              String    @id @default(cuid())
  campaignId      String
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  code            String    @unique
  role            String    @default("player")
  requireApproval Boolean   @default(false)
  /// null = unlimited.
  maxUses         Int?
  uses            Int       @default(0)
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdById     String?
  createdBy       User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  @@index([campaignId])
}

/// A character brought into a campaign. A character belongs to one campaign at most.
model CampaignCharacter {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// pending (waiting for the GM), accepted, returned (sent back with a note).
  status      String    @default("pending")
  note        String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([campaignId])
}

/// Bestiary entry: imported from dnd.su (campaignId null, shared) or a GM's
/// own creature in one campaign.
model Creature {
  id         String    @id @default(cuid())
  /// dndsu | dndsu-homebrew | custom
  source     String
  externalId String?
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  nameRu     String
  nameEn     String    @default("")
  /// tiny | small | medium | large | huge | gargantuan
  size       String    @default("")
  /// Creature type in Russian, lower case: "гуманоид", "дракон"...
  type       String    @default("")
  alignment  String    @default("")
  /// Challenge rating as a number (1/8 = 0.125).
  cr         Float     @default(0)
  ac         Int       @default(10)
  hp         Int       @default(1)
  hpFormula  String    @default("")
  speed      String    @default("")
  /// { str, dex, con, int, wis, cha } scores when the page had them.
  abilities  Json?
  /// The whole statblock as rich text.
  statblock  Json
  sourceBook String    @default("")
  url        String    @default("")
  searchText String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([campaignId])
  @@index([cr])
}

/// Weighted loot table of a campaign (rows in src/lib/loot.ts).
model LootTable {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  folder     String   @default("")
  /// How many times to roll: a dice formula.
  rolls      String   @default("1")
  rows       Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campaignId])
}

/// Rolled loot waiting for the GM to hand it out.
model LootDraft {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String
  /// draft | distributed | discarded
  status     String   @default("draft")
  /// { items: LootItem[], coins: Record<coin, number>, log: string[] }
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campaignId, status])
}

/// Mutations rolled for a character after death, before the GM applies them.
model MutationDraft {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterId String
  /// How long the character was dead, in minutes.
  minutes     Int
  /// draft | applied | discarded
  status      String   @default("draft")
  /// MutationRoll[] (src/lib/mutations.ts)
  rolls       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campaignId, status])
}
