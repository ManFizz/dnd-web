# Postgres connection string (Neon, Supabase, Vercel Postgres or local).
DATABASE_URL="postgresql://dnd:dnd@localhost:5432/dnd?schema=public"

# Better Auth: random secret (openssl rand -base64 32) and the public URL of the site.
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (optional; buttons appear only when both values are set).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Comma separated e-mails that get admin rights (spell library import).
# If empty, the first registered user becomes the admin.
ADMIN_EMAILS=""
